# Copy to .env for local dev.

# SQLite by default — zero setup. Swap to a postgresql:// URL for production
# (see prisma/schema.prisma datasource comment) and change provider to "postgresql".
DATABASE_URL="file:./dev.db"

PORT=4000

# Bearer token required on all Host/Admin API routes (Authorization: Bearer <token>).
HOST_TOKEN="dev-host-token"

# CORS-allowed origin for apps/web during local dev.
WEB_ORIGIN="http://localhost:3000"

# Auto-start the configured live adapter (mock generator or real TikTok,
# see LIVE_SOURCE below) when a session starts/resumes.
MOCK_TIKTOK_ENABLED=true

# "mock" (default) — simulated viewers via src/adapters/mockTikTokAdapter.ts.
# "tiktok" — real TikTok LIVE via src/adapters/tiktokLiveAdapter.ts
# (unofficial tiktok-live-connector library; the target account must
# actually be broadcasting when a session starts).
LIVE_SOURCE="mock"

# Only used when LIVE_SOURCE=tiktok. The creator's @username (no "@").
# Can also be overridden per-session from the Host Dashboard's Start form.
TIKTOK_USERNAME=

# Required when LIVE_SOURCE=tiktok. tiktok-live-connector >=2.x delegates
# request signing to Euler Stream, and the keyless free tier is paid-only.
# Create a free account + API key at https://www.eulerstream.com and paste it here.
TIKTOK_SIGN_API_KEY=

# Optional: connect to TikTok LIVE as a logged-in account. TikTok may not push chat
# comments to anonymous connections. Copy the `sessionid` and `tt-target-idc` cookies
# from a browser logged into TikTok (DevTools > Application > Cookies).
# WARNING: these are forwarded to the Euler Stream sign server - use a SECONDARY account.
TIKTOK_SESSION_ID=
TIKTOK_TT_TARGET_IDC=
